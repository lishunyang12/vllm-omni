+@cute.jit
+def _store_pair_probability_smem(
+    probabilities: cute.Tensor,
+    score_coordinates: cute.Tensor,
+    destination: cute.Tensor,
+):
+    """Store exact P in a logical M64xN128x1 BF16 shared-memory tensor.
+
+    Use the same semantic-row mapping already used for score validity and
+    final statistics. The layout itself supplies the hardware SMEM swizzle;
+    no assumptions about its physical row strides enter the scatter.
+    """
+    semantic_row = (
+        score_coordinates[0][0] + Int32(SEMANTIC_ROW_OFFSET)
+    ) & Int32(M - 1)
+    for i in cutlass.range(cute.size(probabilities), unroll_full=True):
+        column = score_coordinates[i][1]
+        destination[semantic_row, column, 0] = Float32(probabilities[i]).to(BFloat16)
+    # Publish generic shared stores to the asynchronous tcgen05 consumer.
+    # The caller's existing five-warp P-ready rendezvous follows this fence.
+    cute.arch.fence_view_async_shared()
+
