index 0000000..73d488c
--- /dev/null
+++ b/vllm_omni/diffusion/attention/ops/sol_residual.py
@@ -0,0 +1,166 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM-Omni project
+"""Fused SOL residual normalization and merge with FP32 matrix products."""
+
+import torch
+from vllm.triton_utils import tl, triton
+
+
+@triton.jit
+def _normalize_residual(
+    scores,
+    selected,
+    log_sizes,
+    exact_lse,
+    exact_weights,
+    num_rows: tl.constexpr,
+    chunk_len: tl.constexpr,
+    start_query,
+    num_heads: tl.constexpr,
+    num_blocks: tl.constexpr,
+    map_stride_b: tl.constexpr,
+    map_stride_h: tl.constexpr,
+    map_stride_q: tl.constexpr,
+    map_stride_k: tl.constexpr,
+    lse_stride_b: tl.constexpr,
+    lse_stride_h: tl.constexpr,
+    lse_stride_q: tl.constexpr,
+    scale: tl.constexpr,
+    block_m: tl.constexpr,
+    block_n: tl.constexpr,
+):
+    rows = tl.program_id(0) * block_m + tl.arange(0, block_m)
+    cols = tl.arange(0, block_n)
+    q = rows % chunk_len + start_query
+    h = rows // chunk_len % num_heads
+    b = rows // (chunk_len * num_heads)
+    valid = (rows[:, None] < num_rows) & (cols[None, :] < num_blocks)
+    values = tl.load(scores + rows[:, None] * num_blocks + cols[None, :], valid, other=0) * scale
+    exact = tl.load(
+        selected
+        + b[:, None] * map_stride_b
+        + h[:, None] * map_stride_h
+        + (q[:, None] // 64) * map_stride_q
+        + cols[None, :] * map_stride_k,
+        valid,
+        other=1,
+    )
+    values = tl.where(valid & ~exact, values, -float("inf"))
+    sizes = tl.load(log_sizes + cols, cols < num_blocks, other=0)
+    le = tl.load(exact_lse + b * lse_stride_b + h * lse_stride_h + q * lse_stride_q, rows < num_rows, other=0)
+    weighted = values + sizes[None, :]
+    maximum = tl.maximum(tl.max(weighted, 1), le)
+    normalizer = tl.exp(le - maximum) + tl.sum(tl.exp(weighted - maximum[:, None]), 1)
+    joint_lse = maximum + tl.log(normalizer)
+    probabilities = tl.exp(values - joint_lse[:, None])
+    tl.store(scores + rows[:, None] * num_blocks + cols[None, :], probabilities, valid)
+    tl.store(exact_weights + rows, tl.exp(le - joint_lse), rows < num_rows)
+
+
+@triton.jit
+def _merge_residual(
+    residual,
+    exact_output,
+    exact_weights,
+    output,
+    num_elements: tl.constexpr,
+    chunk_len: tl.constexpr,
+    start_query,
+    num_heads: tl.constexpr,
+    head_dim: tl.constexpr,
+    exact_stride_b: tl.constexpr,
+    exact_stride_q: tl.constexpr,
+    exact_stride_h: tl.constexpr,
+    exact_stride_d: tl.constexpr,
+    out_stride_b: tl.constexpr,
+    out_stride_q: tl.constexpr,
+    out_stride_h: tl.constexpr,
+    out_stride_d: tl.constexpr,
+    block_size: tl.constexpr,
+):
+    # Iterate in BSHD order for coalesced writes and exact-output reads.
+    ids = tl.program_id(0) * block_size + tl.arange(0, block_size)
+    d = ids % head_dim
+    h = ids // head_dim % num_heads
+    q_local = ids // (head_dim * num_heads) % chunk_len
+    b = ids // (head_dim * num_heads * chunk_len)
+    q = q_local + start_query
+    row = (b * num_heads + h) * chunk_len + q_local
+    valid = ids < num_elements
+    r = tl.load(residual + row * head_dim + d, valid, other=0)
+    e = tl.load(
+        exact_output + b * exact_stride_b + q * exact_stride_q + h * exact_stride_h + d * exact_stride_d, valid, other=0
+    ).to(tl.float32)
+    weight = tl.load(exact_weights + row, valid, other=0)
+    value = e * weight + r
+    tl.store(output + b * out_stride_b + q * out_stride_q + h * out_stride_h + d * out_stride_d, value, valid)
+
+
+def merge_sol_residual(
+    query: torch.Tensor,
+    key_centroids: torch.Tensor,
+    value_sums: torch.Tensor,
+    selected: torch.Tensor,
+    sizes: torch.Tensor,
+    exact_output: torch.Tensor,
+    exact_lse: torch.Tensor,
+    scale: float,
+    *,
+    chunk_size: int = 2048,
+) -> torch.Tensor:
+    """Keep FP32 GEMMs; fuse masking/normalization and the final weighted merge.
+
+    ``value_sums`` already includes block multiplicity. Only the residual
+    denominator is weighted by ``sizes``. Exact blocks contribute through
+    ``exact_output`` and its natural-log LSE, never through the residual.
+    """
+    batch, tokens, heads, dim = query.shape
+    blocks = sizes.numel()
+    keys = key_centroids.float().transpose(1, 2).transpose(-1, -2)
+    values = value_sums.float().transpose(1, 2)
+    log_sizes = sizes.float().log()
+    output = torch.empty_like(query)
+    bn = triton.next_power_of_2(blocks)
+    bm = 4 if bn <= 2048 else 1
+    for start in range(0, tokens, chunk_size):
+        stop = min(start + chunk_size, tokens)
+        chunk = stop - start
+        scores = query[:, start:stop].float().transpose(1, 2) @ keys
+        exact_weights = torch.empty((batch, heads, chunk), device=query.device, dtype=torch.float32)
+        _normalize_residual[(triton.cdiv(batch * heads * chunk, bm),)](
+            scores,
+            selected,
+            log_sizes,
+            exact_lse,
+            exact_weights,
+            batch * heads * chunk,
+            chunk,
+            start,
+            heads,
+            blocks,
+            *selected.stride(),
+            *exact_lse.stride(),
+            scale,
+            bm,
+            bn,
+            num_warps=8 if bn >= 2048 else 4,
+            enable_fp_fusion=False,
+        )
+        residual = scores @ values
+        elements = batch * chunk * heads * dim
+        _merge_residual[(triton.cdiv(elements, 512),)](
+            residual,
+            exact_output,
+            exact_weights,
+            output,
+            elements,
+            chunk,
+            start,
+            heads,
+            dim,
+            *exact_output.stride(),
+            *output.stride(),
+            512,
+            enable_fp_fusion=False,
+        )
+    return output
